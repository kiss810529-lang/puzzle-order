rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /orders/{id} { allow create: if request.resource.data.phone.matches('^09[0-9]{8}$') && request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.status == '待確認' && request.resource.data.source == 'official-website'; allow read, update, delete: if false; } } }